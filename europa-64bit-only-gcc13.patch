+  /* Europa 64-bit-only: Expand sub-word stores to memory into
+     read-modify-write sequences using only ld/sd.
+       (set (mem:QI/HI/SI (address)) (reg_or_0))
+     becomes:
+       aligned_addr = address & ~7
+       bit_offset = (address & 7) * 8
+       old_val = ld aligned_addr
+       old_val = (old_val & ~(mode_mask << bit_offset))
+                 | ((new_val & mode_mask) << bit_offset)
+       sd old_val, aligned_addr  */
+  if (TARGET_64BIT
+      && GET_MODE_CLASS (mode) == MODE_INT
+      && GET_MODE_SIZE (mode).to_constant () < UNITS_PER_WORD
+      && can_create_pseudo_p ()
+      && MEM_P (dest))
+    {
+      unsigned HOST_WIDE_INT mode_size = GET_MODE_SIZE (mode).to_constant ();
+      rtx addr = XEXP (dest, 0);
+      rtx addr_reg = force_reg (Pmode, addr);
+
+      /* Compute aligned address: aligned_addr = addr & ~7.  */
+      rtx aligned_addr = gen_reg_rtx (Pmode);
+      emit_insn (gen_anddi3 (aligned_addr, addr_reg,
+			     gen_int_mode (-8, Pmode)));
+
+      /* Compute byte offset: byte_off = addr & 7.  */
+      rtx byte_off = gen_reg_rtx (Pmode);
+      emit_insn (gen_anddi3 (byte_off, addr_reg, GEN_INT (7)));
+
+      /* Compute bit offset: bit_off = byte_off << 3.  */
+      rtx bit_off = gen_reg_rtx (Pmode);
+      emit_insn (gen_ashldi3 (bit_off, byte_off, GEN_INT (3)));
+
+      /* Load the containing 8-byte word.  */
+      rtx aligned_mem = gen_rtx_MEM (DImode, aligned_addr);
+      set_mem_alias_set (aligned_mem, 0);
+      MEM_VOLATILE_P (aligned_mem) = MEM_VOLATILE_P (dest);
+      rtx old_val = gen_reg_rtx (DImode);
+      emit_move_insn (old_val, aligned_mem);
+
+      /* Create mode mask (e.g. 0xFF for QI, 0xFFFF for HI, etc.).  */
+      unsigned HOST_WIDE_INT mode_mask
+	= ((unsigned HOST_WIDE_INT) 1 << (mode_size * 8)) - 1;
+
+      /* Build shifted mask.  */
+      rtx mask_val = gen_reg_rtx (DImode);
+      emit_move_insn (mask_val, gen_int_mode (mode_mask, DImode));
+      rtx shifted_mask = gen_reg_rtx (DImode);
+      emit_insn (gen_ashldi3 (shifted_mask, mask_val,
+			      gen_lowpart (QImode, bit_off)));
+      rtx inv_mask = gen_reg_rtx (DImode);
+      emit_insn (gen_one_cmpldi2 (inv_mask, shifted_mask));
+
+      /* Clear target bits in old value.  */
+      rtx cleared = gen_reg_rtx (DImode);
+      emit_insn (gen_anddi3 (cleared, old_val, inv_mask));
+
+      /* Get new value into DImode and shift into position.  Use ZERO_EXTEND
+	 (not gen_lowpart) to avoid creating a subreg that is unrecognizable
+	 in anddi3.  Zero-extension zeros the upper bits, equivalent to
+	 masking with mode_mask.  */
+      rtx new_val;
+      if (src == CONST0_RTX (mode))
+	{
+	  new_val = const0_rtx;
+	}
+      else
+	{
+	  rtx src_reg = force_reg (mode, src);
+	  rtx src_di = gen_reg_rtx (DImode);
+	  emit_move_insn (src_di, gen_rtx_ZERO_EXTEND (DImode, src_reg));
+	  new_val = gen_reg_rtx (DImode);
+	  emit_insn (gen_ashldi3 (new_val, src_di,
+				  gen_lowpart (QImode, bit_off)));
+	}
+
+      /* Merge and store back.  */
+      rtx result = gen_reg_rtx (DImode);
+      if (new_val == const0_rtx)
+	result = cleared;
+      else
+	emit_insn (gen_iordi3 (result, cleared, new_val));
+
+      rtx store_mem = gen_rtx_MEM (DImode, aligned_addr);
+      set_mem_alias_set (store_mem, 0);
+      MEM_VOLATILE_P (store_mem) = MEM_VOLATILE_P (dest);
+      emit_move_insn (store_mem, result);
+      return true;
+    }
